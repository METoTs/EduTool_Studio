/* EduTool feature navigation. Keep these rules scoped to the new shell. */
QToolBar#eduToolFeatureBar {
    background: #09203a;
    border-bottom: 1px solid #184c79;
    spacing: 8px;
    padding: 8px 12px;
}

QToolBar#eduToolFeatureBar::separator {
    background: #265072;
    width: 1px;
    margin: 4px 8px;
}

QToolBar#eduToolFeatureBar QToolButton {
    background: transparent;
    color: #d9e8f8;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 9px 16px;
    font-weight: 600;
}

QToolBar#eduToolFeatureBar QToolButton:hover {
    background: #123b62;
}

QToolBar#eduToolFeatureBar QToolButton:checked {
    background: #1266cf;
    border-color: #328dff;
    color: white;
}

QLabel#eduToolBrand {
    color: #e7f1ff;
    font-size: 18px;
    font-weight: 700;
    padding: 0 8px;
}

QLabel#eduToolActivityStatus {
    color: #7ce5cf;
    font-weight: 600;
    padding: 0 8px;
}

QWidget#eduToolFeaturePage {
    background: #0b2946;
}

QLabel#eduToolFeatureHeading {
    color: white;
    font-size: 30px;
    font-weight: 700;
}

QLabel#eduToolFeatureSummary {
    color: #c9daec;
    font-size: 16px;
}

QDialog#eduToolSourceManager, QDialog#eduToolCameraSettings, QDialog#eduToolAudioSettings {
    background: #09203a;
}

QLabel#eduToolSourceHeading, QLabel#eduToolCameraHeading, QLabel#eduToolAudioHeading {
    color: #e7f1ff;
    font-size: 24px;
    font-weight: 700;
}

QListWidget#eduToolSourceList {
    background: #06192d;
    border: 1px solid #184c79;
    border-radius: 6px;
    padding: 8px;
}

QListWidget#eduToolSourceList::item {
    padding: 12px;
    min-height: 26px;
}

QListWidget#eduToolSourceList::item:selected {
    background: #1266cf;
    color: white;
}

QDialog#eduToolSourceManager QPushButton, QDialog#eduToolCameraSettings QPushButton,
QDialog#eduToolAudioSettings QPushButton {
    padding: 10px 14px;
    border-radius: 6px;
}

QWidget#eduToolEditor, QWidget#eduToolPortal {
    background: #09203a;
}

QWidget#eduToolEditor QPushButton, QWidget#eduToolPortal QPushButton {
    padding: 8px 12px;
    border: 1px solid #205887;
    border-radius: 6px;
    background: #103754;
    color: #e7f1ff;
}

QWidget#eduToolEditor QPushButton:hover, QWidget#eduToolPortal QPushButton:hover {
    background: #1266cf;
}

QWidget#eduToolEditor QPushButton:disabled, QWidget#eduToolPortal QPushButton:disabled {
    background: #142837;
    color: #6d7e8c;
}

QWidget#eduToolEditor QListWidget {
    border: 1px solid #205887;
    border-radius: 6px;
    background: #06192d;
}

QWidget#eduToolEditor QListWidget::item {
    padding: 12px;
}

QPushButton#recordButton {
    font-weight: 700;
}
