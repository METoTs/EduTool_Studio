/* EduTool feature navigation. Keep these rules scoped to the new shell. */
QToolBar#eduToolFeatureBar {
    background: #09203a;
    border-bottom: 1px solid #184c79;
    spacing: 8px;
    padding: 8px 12px;
}

QToolBar#eduToolFeatureBar::separator {
    background: #265072;
    width: 1px;
    margin: 4px 8px;
}

QToolBar#eduToolFeatureBar QToolButton {
    background: transparent;
    color: #d9e8f8;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 9px 16px;
    font-weight: 600;
}

QToolBar#eduToolFeatureBar QToolButton:hover {
    background: #123b62;
}

QToolBar#eduToolFeatureBar QToolButton:checked {
    background: #1266cf;
    border-color: #328dff;
    color: white;
}

QLabel#eduToolBrand {
    color: #e7f1ff;
    font-size: 18px;
    font-weight: 700;
    padding: 0 8px;
}

QLabel#eduToolActivityStatus {
    color: #7ce5cf;
    font-weight: 600;
    padding: 0 8px;
}

QWidget#eduToolFeaturePage {
    background: #0b2946;
}

QLabel#eduToolFeatureHeading {
    color: white;
    font-size: 30px;
    font-weight: 700;
}

QLabel#eduToolFeatureSummary {
    color: #c9daec;
    font-size: 16px;
}

QDialog#eduToolSourceManager, QDialog#eduToolCameraSettings, QDialog#eduToolAudioSettings {
    background: #09203a;
}

QLabel#eduToolSourceHeading, QLabel#eduToolCameraHeading, QLabel#eduToolAudioHeading {
    color: #e7f1ff;
    font-size: 24px;
    font-weight: 700;
}

QListWidget#eduToolSourceList {
    background: #06192d;
    border: 1px solid #184c79;
    border-radius: 6px;
    padding: 8px;
}

QListWidget#eduToolSourceList::item {
    padding: 12px;
    min-height: 26px;
}

QListWidget#eduToolSourceList::item:selected {
    background: #1266cf;
    color: white;
}

QDialog#eduToolSourceManager QPushButton, QDialog#eduToolCameraSettings QPushButton,
QDialog#eduToolAudioSettings QPushButton {
    padding: 10px 14px;
    border-radius: 6px;
}

QWidget#eduToolEditor, QWidget#eduToolPortal {
    background: #09203a;
}

QWidget#eduToolEditor QPushButton, QWidget#eduToolPortal QPushButton {
    padding: 8px 12px;
    border: 1px solid #205887;
    border-radius: 6px;
    background: #103754;
    color: #e7f1ff;
}

QWidget#eduToolEditor QPushButton:hover, QWidget#eduToolPortal QPushButton:hover {
    background: #1266cf;
}

QWidget#eduToolEditor QPushButton:disabled, QWidget#eduToolPortal QPushButton:disabled {
    background: #142837;
    color: #6d7e8c;
}

QWidget#eduToolEditor QListWidget {
    border: 1px solid #205887;
    border-radius: 6px;
    background: #06192d;
}

QWidget#eduToolEditor QListWidget::item {
    padding: 12px;
}

QPushButton#recordButton {
    font-weight: 700;
}

/* Fixed capture shell: independent of the user's saved OBS dock geometry. */
QWidget#eduToolCapturePage, QWidget#eduToolDevicePanel {
    background: #071f35;
    color: #e9f3ff;
}
QFrame#eduToolPreviewFrame, QFrame#eduToolDeviceCard, QFrame#eduToolCaptureActions {
    background: #09253e;
    border: 1px solid #194d70;
    border-radius: 10px;
}
QWidget#eduToolCapturePage QLabel { color: #d9eafa; background: transparent; }
QLabel#eduToolCardHeading { font-size: 20px; font-weight: 700; color: white; }
QToolBar#eduToolCapturePreviewBar { background: transparent; border: none; spacing: 8px; padding: 2px; }
QWidget#eduToolCapturePage QPushButton, QToolBar#eduToolCapturePreviewBar QToolButton {
    background: #103753; color: #eaf4ff; border: 1px solid #24618b;
    border-radius: 6px; padding: 8px 12px;
}
QWidget#eduToolCapturePage QPushButton:hover, QToolBar#eduToolCapturePreviewBar QToolButton:hover { background: #175386; }
QWidget#eduToolCapturePage QPushButton:disabled { color: #71879b; background: #122b3d; border-color: #233d50; }
QFrame#eduToolCaptureActions QPushButton { font-weight: 600; }
QWidget#eduToolCapturePage QPushButton#eduToolRecordButton, QWidget#eduToolCapturePage QPushButton#eduToolStreamButton {
    background: #f41439; border: 1px solid #ff4563; color: white;
    font-size: 20px; font-weight: 700; padding: 12px 24px;
}
QWidget#eduToolCapturePage QPushButton#eduToolRecordButton:hover, QWidget#eduToolCapturePage QPushButton#eduToolStreamButton:hover { background: #ff3655; }
QWidget#eduToolCapturePage QPushButton#eduToolRecordButton[secondary="true"] { background: #103753; border-color: #24618b; }
QWidget#eduToolCapturePage QScrollArea { border: none; background: #071f35; }

QWidget#eduToolCapturePage VolumeControl QPushButton { padding: 2px; min-width: 22px; min-height: 22px; }
QWidget#eduToolCapturePage VolumeControl { background: transparent; }
QToolBar#eduToolFeatureBar QToolButton { font-size: 16px; }
